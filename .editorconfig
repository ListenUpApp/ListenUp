root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.{kt,kts}]
# Only disable function-naming for Composable functions (PascalCase is Compose convention)
ktlint_function_naming_ignore_when_annotated_with = Composable
# Allow wildcard imports for iOS platform interop (convention in KMP)
ij_kotlin_packages_to_use_import_on_demand = platform.**,kotlinx.cinterop.**
# Disable import ordering when comments are present (Koin.kt has section comments)
ktlint_standard_import-ordering = disabled

[*.md]
trim_trailing_whitespace = false

[*Test.kt]
# Tests get a longer line than production code — but a LIMIT, matching detekt's MaxLineLength (140).
# This used to disable ktlint's rule outright, which ktlint treats as "no limit" for its own wrapping
# decisions: its function-signature rule then re-joins any expression body onto the signature line
# at any length, and detekt fails the very lines ktlint just produced. Two formatters must agree.
max_line_length = 140
ktlint_ignore_back_ticked_identifier = true

[*.{yml,yaml}]
indent_size = 2
