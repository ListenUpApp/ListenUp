# Two-stage runtime image for the Kotlin/Native server.kexe.
#
# We COMPILE SQLite inside a debian:12 builder because **distroless/cc ships no SQLite at all** —
# verified by exporting the base: it carries glibc, libgcc, libstdc++, libcrypto/libssl and nothing
# else. The binary links libsqlite3.so.0, so without this stage the image has no SQLite to load and
# the server cannot start. (An earlier comment here claimed we were overriding "the base's 3.40.1";
# there is no base SQLite to override. That mistake made this stage look like a deletion candidate
# once FTS5 went away — it is not one.) Building against debian:12 links the same glibc 2.36 the
# distroless base provides. Static-linking is not an option (K/N can't link host-built .a archives;
# no musl target) — see docs/plans/050 §5.
#
# Version floor: our own SQL needs **3.35** (`ALTER TABLE ... DROP COLUMN`, in
# V53__drop_blurhash_columns.sql). We pin far above that because the base ships nothing, so the
# version is ours to choose and a pinned modern one beats an accidental old one.
#
# FTS5 IS REQUIRED, and the reason is easy to get wrong. The running server issues zero FTS5
# queries — the four search indexes and the whole server-side search surface were removed — and the
# linked binary exports zero fts5 symbols. Both facts are true and both are irrelevant: the SQLite
# that has to understand `USING fts5` is THIS shared library, at migration time, and
# `V1__baseline.sql` still creates four fts5 virtual tables because the squashed baseline
# reproduces the historical schema. Dropping the flag on the strength of "no FTS5 usage" produced
# an image that died on first boot with `no such module: fts5` — a release-blocking break that CI
# could not see, because CI never builds this image and the tests run against the host's SQLite.
# The verify step below turns that into a build failure instead of a runtime one.
FROM debian:12-slim AS libs
ARG SQLITE_AMALGAMATION_URL=https://www.sqlite.org/2024/sqlite-amalgamation-3450000.zip
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc libc6-dev ca-certificates curl unzip libargon2-1 libcurl4 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -fsSL -o amalg.zip "$SQLITE_AMALGAMATION_URL" \
    && unzip -q amalg.zip \
    && cd sqlite-amalgamation-* \
    && gcc -O2 -fPIC -shared -DSQLITE_ENABLE_FTS5 -o /build/libsqlite3.so.0 sqlite3.c -lm \
    && cp sqlite3.h /build/ \
    && cat sqlite3.h | grep -m1 '#define SQLITE_VERSION ' \
    && awk '/#define SQLITE_VERSION_NUMBER/ { if ($3 < 3035000) { print "SQLite too old: " $3; exit 1 } }' sqlite3.h

# Prove the fts5 module is actually loadable rather than trusting the compile flag: link a throwaway
# client against the .so we just built and have it run the exact statement V1__baseline.sql runs.
# A missing module now fails the BUILD, loudly, instead of the server's first boot.
RUN printf '%s\n' \
        '#include <sqlite3.h>' \
        '#include <stdio.h>' \
        'int main(void){' \
        '  sqlite3 *db; char *err = 0;' \
        '  if (sqlite3_open(":memory:", &db) != SQLITE_OK) { fprintf(stderr, "open failed\n"); return 1; }' \
        '  if (sqlite3_exec(db, "CREATE VIRTUAL TABLE t USING fts5(x);", 0, 0, &err) != SQLITE_OK) {' \
        '    fprintf(stderr, "FTS5 MISSING: %s\n", err ? err : "(no message)"); return 1;' \
        '  }' \
        '  printf("fts5 module present\n"); return 0;' \
        '}' > /build/fts5check.c \
    && gcc -O2 -o /build/fts5check /build/fts5check.c -I/build /build/libsqlite3.so.0 -lm \
    && /build/fts5check \
    && rm -f /build/fts5check /build/fts5check.c /build/sqlite3.h
# An empty /data to seed the runtime image's data dir — the distroless base has no shell, so the dir is
# created here and COPY --chown'd into the final stage below.
RUN mkdir -p /data
# Stage libcurl + its full transitive .so closure for the Kotlin/Native Curl HTTP engine (metadata
# outbound HTTPS). distroless/cc ships none of these. `ldd` resolves the complete recursive closure;
# exclude the glibc/libgcc/libstdc++ core libs the distroless/cc base already provides.
RUN mkdir -p /curl-deps \
    && cp -L /usr/lib/x86_64-linux-gnu/libcurl.so.4 /curl-deps/ \
    && ldd /usr/lib/x86_64-linux-gnu/libcurl.so.4 \
        | awk '/=> \// { print $3 }' \
        | grep -vE '/(libc|libm|libdl|libpthread|librt|libgcc_s|libstdc\+\+)\.so' \
        | while read -r lib; do cp -L "$lib" /curl-deps/; done


# ── Transcoding media stack ────────────────────────────────────────────────────────────────────
# ⛔ FFmpeg ALONE IS NOT ENOUGH, and the failure is silent. Its native xHE-AAC (USAC) decoder is
# incomplete at `ff_aac_parse_fac_data` — the data USAC needs at every switch between its speech
# coder and its transform coder, which narrated speech does constantly. It drops the packets it
# cannot parse, writes short segments, and **exits 0**. Measured over 61 files sampled from a real
# 973-file xHE library: every single one affected, a median of 23% of the audio silently gone, and
# an HLS playlist that still declares the correct full duration. Reproduced identically on FFmpeg
# 9.0.1 and on master — this is not a version or build issue.
#
# Fraunhofer FDK decodes them exactly (0.000% loss, verified against two real books), so xHE-AAC is
# decoded by GStreamer's fdkaacdec and only ENCODED by FFmpeg. FFmpeg itself stays stock: linking
# FDK into it would require `--enable-nonfree`, and such builds may not be redistributed.
#
# Debian ships neither piece — no fdkaacdec in gstreamer1.0-plugins-bad, and libfdk-aac2 only in
# non-free — so the plugin is built here. `-Dauto_features=disabled -Dfdkaac=enabled` builds that
# one plugin rather than all of gst-plugins-bad, which takes about eight seconds.
FROM debian:12-slim AS media
ARG GST_VERSION=1.22.0
ARG FFMPEG_VERSION=7.1.1
# Edit the deb822 source in place. Adding a legacy .list line collides with the base image's
# Signed-By and breaks apt outright with "Conflicting values set for option Signed-By".
RUN sed -i "s/^Components: main$/Components: main contrib non-free/" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config curl ca-certificates xz-utils yasm nasm \
        libfdk-aac-dev libglib2.0-dev \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    && rm -rf /var/lib/apt/lists/*

# ⛔ Build FFmpeg rather than installing Debian's. `apt-get install ffmpeg` drags in a codec zoo this
# server never touches — measured at **237 MB** of shared libraries: libicudata 29.8, libcodec2 16.1,
# libx265 15.6, plus rsvg, placebo, lapack, SvtAv1Enc, aom. The transcoder needs AAC in and out, mp4
# and matroska demux, and the adts/segment muxers. Configured that way and linked statically it is
# **2.4 MB** and links only libc and libm, so it adds no shared objects to the runtime image at all.
#
# LGPL: no GPL-only component is enabled, so the binary stays redistributable. Do not add
# --enable-libfdk-aac here — that would require --enable-nonfree, and such builds may not be
# redistributed. FDK decodes through GStreamer instead, as a separate program.
RUN curl -fsSL -o ff.tar.xz "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" \
    && tar -xJf ff.tar.xz \
    && cd ffmpeg-${FFMPEG_VERSION} \
    && ./configure \
        --disable-everything --disable-autodetect --disable-doc --disable-network \
        --disable-shared --enable-static --enable-small --disable-debug \
        --enable-decoder=aac,pcm_s16le \
        --enable-encoder=aac \
        --enable-demuxer=mov,matroska,aac,pcm_s16le \
        --enable-muxer=matroska,adts,segment,stream_segment \
        --enable-parser=aac \
        --enable-protocol=file,pipe \
        --enable-filter=aresample,anull,aformat \
        --enable-bsf=aac_adtstoasc \
    && make -j"$(nproc)" ffmpeg \
    && strip ffmpeg \
    && cp ffmpeg /usr/local/bin/ffmpeg

# ⛔ FFMPEG ALONE IS NOT ENOUGH, and the failure is silent. Its native xHE-AAC (USAC) decoder is
# incomplete at `ff_aac_parse_fac_data` — the data USAC needs at every switch between its speech
# coder and its transform coder, which narrated speech does constantly. It drops the packets it
# cannot parse, writes short segments, and **exits 0**. Measured over 61 files sampled from a real
# 973-file xHE library: every single one affected, a median of 23% of the audio silently gone, and
# an HLS playlist that still declares the correct full duration. Reproduced identically on FFmpeg
# 9.0.1 and on master — this is not a version or build issue.
#
# Fraunhofer FDK decodes them exactly (0.000% loss, verified against two real books), so xHE-AAC is
# decoded here and only ENCODED by FFmpeg. Debian ships neither piece — no fdkaacdec in
# gstreamer1.0-plugins-bad, and libfdk-aac2 only in non-free — so the plugin is built from source.
# `-Dauto_features=disabled -Dfdkaac=enabled` builds that one plugin rather than all of
# gst-plugins-bad, which takes about eight seconds.
RUN curl -fsSL -o bad.tar.xz \
        "https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-${GST_VERSION}.tar.xz" \
    && tar -xJf bad.tar.xz \
    && cd gst-plugins-bad-${GST_VERSION} \
    && meson setup build --prefix=/usr --libdir=lib/x86_64-linux-gnu \
        -Dauto_features=disabled -Dfdkaac=enabled -Dexamples=disabled -Dtests=disabled \
    && ninja -C build \
    && find build -name 'libgstfdkaac.so' -exec cp {} /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ \;

# Prove both halves work rather than trusting the builds: a missing element exits 1, so a silently
# failed plugin build fails HERE instead of at a listener's first xHE segment.
RUN gst-launch-1.0 -q fakesrc num-buffers=0 ! fdkaacdec ! fakesink \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -qE '^ *A[A-Z.]+ +aac ' \
    && ffmpeg -hide_banner -muxers   2>/dev/null | grep -qE '^ *E +segment ' \
    && ffmpeg -hide_banner -muxers   2>/dev/null | grep -qE '^ *E +matroska ' \
    && ffmpeg -hide_banner -demuxers 2>/dev/null | grep -qE '^ *D +mov,' \
    && ffmpeg -hide_banner -protocols 2>/dev/null | grep -qx '  pipe'

# ── Third-party licence obligations ───────────────────────────────────────────────────────────
# ⛔ NOT OPTIONAL, and not satisfiable by a link. The Fraunhofer FDK licence requires, for binary
# redistribution: "You must retain the complete text of this software license in the documentation
# and/or other materials provided with redistributions of the FDK AAC Codec ... in binary form. You
# must make available free of charge copies of the complete source code of the FDK AAC Codec ... to
# recipients of copies in binary form."
#
# It also grants NO patent licence — AAC patent claims are licensed separately (Via Licensing).
#
# FFmpeg and GStreamer ship here as LGPL programs and carry their own notice obligations, so their
# licence texts travel with them too. ListenUp itself is AGPL-3.0 and is unaffected: none of these
# are linked into the server, which spawns them as separate programs over OS pipes.
RUN set -eu; mkdir -p /stage/licenses; \
    cp /usr/share/doc/libfdk-aac2/copyright     /stage/licenses/fdk-aac.LICENSE.txt; \
    cp /usr/share/doc/libgstreamer1.0-0/copyright /stage/licenses/gstreamer.LICENSE.txt; \
    cp "/ffmpeg-${FFMPEG_VERSION}/COPYING.LGPLv2.1" /stage/licenses/ffmpeg.LICENSE.txt; \
    FDK_VERSION="$(dpkg-query -W -f='${Version}' libfdk-aac2)"; \
    GST_RUNTIME="$(dpkg-query -W -f='${Version}' libgstreamer1.0-0)"; \
    { \
      echo "Third-party components redistributed in this image"; \
      echo "================================================="; \
      echo; \
      echo "ListenUp itself is AGPL-3.0. The components below are separate programs, invoked by the"; \
      echo "server over OS pipes and never linked into it. Each is redistributed under its own"; \
      echo "licence, the full text of which is in this directory."; \
      echo; \
      echo "1. Fraunhofer FDK AAC Codec Library  (libfdk-aac2 ${FDK_VERSION})"; \
      echo "   Licence : fdk-aac.LICENSE.txt"; \
      echo "   Source  : https://sources.debian.org/src/fdk-aac/  (Debian source package)"; \
      echo "             https://github.com/mstorsjo/fdk-aac      (upstream)"; \
      echo "   NOTE    : This licence grants NO patent rights. AAC patent claims are licensed"; \
      echo "             separately; see https://www.via-la.com/ ."; \
      echo "   Used ONLY to decode xHE-AAC (USAC), which FFmpeg cannot decode correctly."; \
      echo; \
      echo "2. FFmpeg ${FFMPEG_VERSION}  (built from source, LGPL v2.1+)"; \
      echo "   Licence : ffmpeg.LICENSE.txt"; \
      echo "   Source  : https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz"; \
      echo "   Built with --disable-everything and no GPL or nonfree component; the exact"; \
      echo "   ./configure line is in server/Dockerfile.native in the ListenUp repository."; \
      echo; \
      echo "3. GStreamer ${GST_RUNTIME} and the gst-plugins-bad fdkaac plugin ${GST_VERSION}  (LGPL)"; \
      echo "   Licence : gstreamer.LICENSE.txt"; \
      echo "   Source  : https://gstreamer.freedesktop.org/src/"; \
      echo "   The fdkaac plugin is built from unmodified upstream source; see the Dockerfile."; \
      echo; \
      echo "None of these components has been modified."; \
    } > /stage/licenses/README.txt; \
    ls -l /stage/licenses

# Only the plugins the pipeline actually loads. Named explicitly rather than copying the whole plugin
# directory: every extra .so is another closure to stage and another late failure.
RUN set -eu; P=/usr/lib/x86_64-linux-gnu/gstreamer-1.0; mkdir -p /stage/plugins /stage/libs; \
    for p in libgstcoreelements.so libgstisomp4.so libgstmatroska.so libgstaudioconvert.so \
             libgstaudioresample.so libgsttypefindfunctions.so libgstfdkaac.so; do \
      cp "$P/$p" /stage/plugins/; done; \
    for b in /usr/bin/gst-launch-1.0 /stage/plugins/*.so; do \
      ldd "$b" | awk '/=> \// { print $3 }'; done \
      | sort -u \
      | grep -vE '/(libc|libm|libdl|libpthread|librt|libgcc_s|libstdc\+\+)\.so' \
      | while read -r lib; do cp -L "$lib" /stage/libs/; done; \
    cp /usr/bin/gst-launch-1.0 /usr/local/bin/ffmpeg /stage/; \
    du -sh /stage

FROM gcr.io/distroless/cc-debian12:nonroot
# None of these three are in distroless/cc. libcrypt.so.1 — Debian split it out of glibc into
# libcrypt1 and the binary links crypt(3). libsqlite3.so.0 — our self-built build from the stage
# above; the base ships no SQLite whatsoever. libargon2.so.1 — debian's.
COPY --from=libs /build/libsqlite3.so.0                     /usr/lib/x86_64-linux-gnu/
COPY --from=libs /usr/lib/x86_64-linux-gnu/libargon2.so.1   /usr/lib/x86_64-linux-gnu/
COPY --from=libs /usr/lib/x86_64-linux-gnu/libcrypt.so.1    /usr/lib/x86_64-linux-gnu/
# CA trust store + libcurl and its transitive closure, for the Kotlin/Native Curl HTTP engine the
# metadata slice uses for outbound HTTPS (Audible/iTunes). distroless/cc ships neither; CIO's native TLS
# is unsupported, so metadata lookups need libcurl + a CA bundle present at runtime.
COPY --from=libs /curl-deps/                                /usr/lib/x86_64-linux-gnu/
COPY --from=libs /etc/ssl/certs/ca-certificates.crt        /etc/ssl/certs/ca-certificates.crt
COPY server-binary /usr/local/bin/listenup-server
# The server runs as nonroot (uid 65532, from the distroless base) and writes its DB, secrets, and
# extracted covers under /data. Ship /data pre-created and owned by 65532 so a fresh Docker *named
# volume* inherits that ownership (Docker seeds a new volume from the image mountpoint's owner/perms),
# letting the server write on first boot. Without it, a named-volume run fails: the nonroot process
# can't create /data/.lock, which the data-dir lock then misreports as "another server is running".
# (Bind mounts still need a host-side `chown 65532` or `--user`; that's inherent to bind mounts.)
COPY --from=libs --chown=65532:65532 /data /data
# The transcoding media stack. GStreamer's plugin registry is rebuilt on first use and needs a
# writable path; /tmp is the only one here, and rebuilding it costs a second at boot.
COPY --from=media /stage/libs/    /usr/lib/x86_64-linux-gnu/
COPY --from=media /stage/plugins/ /opt/gst-plugins/
COPY --from=media /stage/gst-launch-1.0 /stage/ffmpeg /usr/local/bin/
# Licence texts and the written source offer travel with the binaries they cover.
COPY --from=media /stage/licenses/ /usr/share/licenses/listenup-media/
ENV GST_PLUGIN_SYSTEM_PATH=/opt/gst-plugins \
    GST_PLUGIN_PATH=/opt/gst-plugins \
    GST_REGISTRY=/tmp/gst-registry.bin \
    GST_REGISTRY_FORK=no
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/listenup-server"]
