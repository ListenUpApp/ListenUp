-- listening_events: per-user append-only listening spans (Playback P2). Syncable,
-- soft-deletable, revision-tracked, and userScoped — every row carries the owning
-- `user_id`, so the per-user substrate variants filter every pull/digest by that user.
-- Append-only: domain fields are never mutated after insert; a re-upsert of the same
-- id advances only revision/updated_at/client_op_id (idempotent pending-op replay).
-- Column set matches V16__listening_events_and_user_stats.sql exactly.
CREATE TABLE listening_events (
    id                  TEXT    NOT NULL PRIMARY KEY,
    user_id             TEXT    NOT NULL,
    book_id             TEXT    NOT NULL,
    start_position_ms   INTEGER NOT NULL,
    end_position_ms     INTEGER NOT NULL,
    started_at          INTEGER NOT NULL,
    ended_at            INTEGER NOT NULL,
    playback_speed      REAL    NOT NULL,
    tz                  TEXT    NOT NULL,
    device_label        TEXT,
    revision            INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    client_op_id        TEXT
);

CREATE INDEX idx_listening_events_user_revision ON listening_events(user_id, revision);
CREATE INDEX idx_listening_events_user_ended_at ON listening_events(user_id, ended_at);
CREATE INDEX idx_listening_events_user_book     ON listening_events(user_id, book_id);

-- Global substrate queries (kept for source-compatibility with the base contract;
-- a userScoped repo routes pullSince/digest through the *ForUser variants instead).

existsById:
SELECT EXISTS(SELECT 1 FROM listening_events WHERE id = :id);

softDeleteById:
UPDATE listening_events
SET revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at,
    client_op_id = :client_op_id
WHERE id = :id;

selectIdsAboveRevision:
SELECT id, revision FROM listening_events WHERE revision > :cursor ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMost:
SELECT id, revision FROM listening_events WHERE deleted_at IS NULL AND revision <= :cursor;

-- User-scoped substrate variants — the per-user filtering
-- `(revision <cmp> cursor) AND user_id = userId`.

selectIdsAboveRevisionForUser:
SELECT id, revision FROM listening_events
WHERE user_id = :userId AND revision > :cursor
ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMostForUser:
SELECT id, revision FROM listening_events
WHERE user_id = :userId AND deleted_at IS NULL AND revision <= :cursor;

-- Domain queries.

-- Tombstone-inclusive read by id. Used by the base's pullSince/readPayloads.
selectById:
SELECT * FROM listening_events WHERE id = :id;

selectByIds:
SELECT * FROM listening_events WHERE id IN :ids;

-- Test helper: all event ids for a user (tombstone-inclusive, insertion order not guaranteed).
selectIdsByUserId:
SELECT id FROM listening_events WHERE user_id = :user_id;

insert:
INSERT INTO listening_events (
    id, user_id, book_id, start_position_ms, end_position_ms, started_at, ended_at,
    playback_speed, tz, device_label, revision, created_at, updated_at, deleted_at, client_op_id
)
VALUES (
    :id, :user_id, :book_id, :start_position_ms, :end_position_ms, :started_at, :ended_at,
    :playback_speed, :tz, :device_label, :revision, :created_at, :updated_at, :deleted_at, :client_op_id
);

-- Append-only re-upsert: advance only the sync-discipline columns, never the domain fields. Scoped
-- by user_id so one user replaying another user's event id can never touch that row (cross-user
-- authz): the id is a global PK but ownership is per-user.
updateSyncColumns:
UPDATE listening_events
SET revision = :revision, updated_at = :updated_at, client_op_id = :client_op_id
WHERE id = :id AND user_id = :user_id;

-- Stats support: a user's non-deleted events ordered by ended_at ascending (backfill walk).
selectForUserOrderedByEndedAt:
SELECT * FROM listening_events
WHERE user_id = :userId AND deleted_at IS NULL
ORDER BY ended_at ASC;

-- Stats support: does the user have any OTHER event for this book (excluding :excludingId)?
-- Backs the "first event for this book" booksStarted increment.
existsOtherEventForBook:
SELECT EXISTS(
    SELECT 1 FROM listening_events
    WHERE user_id = :userId AND book_id = :bookId AND id != :excludingId
);

-- Stats support: SUM of wall-clock seconds for live events that ended at/after :windowStartMs — the
-- StatsWindow counting rule: a span that began before the window but ended inside it counts whole,
-- exactly as Home counts it (per-row integer seconds, like StatsWindow.secondsCounted). Soft-deleted
-- rows are excluded (deleted_at IS NULL) so the window agrees with the all-time and streak reads that
-- derive from the same primitive. Returns 0 when no live rows fall in the window.
sumWallSecondsEndedSince:
SELECT CAST(COALESCE(SUM((ended_at - started_at) / 1000), 0) AS INTEGER)
FROM listening_events
WHERE user_id = :userId AND ended_at >= :windowStartMs AND deleted_at IS NULL;

-- Stats support: content coverage (summed end-start position deltas, negatives clamped to 0) a user
-- accrued on :bookId strictly after :sinceMs. Drives the re-read coverage rule — a genuine re-read
-- traverses real content since the last finish, a "rewound to the last chapter" replay does not.
-- Live rows only. CAST keeps the result Long; the two-arg MAX is SQLite's scalar max, not the aggregate.
sumPositionDeltaForBookSince:
SELECT CAST(COALESCE(SUM(MAX(end_position_ms - start_position_ms, 0)), 0) AS INTEGER)
FROM listening_events
WHERE user_id = :userId AND book_id = :bookId AND ended_at > :sinceMs AND deleted_at IS NULL;

-- Real-listen support: total wall-clock listening (ms) a user put into :bookId in spans that ended
-- after :sinceMs — i.e. within the current listen-through. Spans are counted whole rather than
-- clipped at :sinceMs: a listen-through's start is stamped from the first position write, which can
-- land a few seconds into the very span that began it. Live rows only.
sumWallMsForBookEndedAfter:
SELECT CAST(COALESCE(SUM(ended_at - started_at), 0) AS INTEGER)
FROM listening_events
WHERE user_id = :userId AND book_id = :bookId AND ended_at > :sinceMs AND deleted_at IS NULL;

-- Stats support: the ended-at timestamps of a user's non-deleted events at/after :cutoffMs, ascending.
-- Feeds the windowed-streak walk (longest consecutive listening-day run within a trailing window).
selectEndedAtForUserSince:
SELECT ended_at FROM listening_events
WHERE user_id = :userId AND deleted_at IS NULL AND ended_at >= :cutoffMs
ORDER BY ended_at ASC;

-- Presence fill: one row per OTHER user — the book of their newest closed listen that they have not
-- finished. Feeds the recent half of "What Others Are Listening To" beneath the live sessions. A
-- closed listen is the same evidence the Activity feed's LISTENING_SESSION row is written from, so
-- Discover and Activity can never disagree about who was listening: opening a book or scrubbing moves
-- a position but closes no listen, and so puts nobody here.
--
-- Only listens of at least :minDurationMs count (the caller passes RealListen.THRESHOLD_MS, the line
-- below which the feed does not announce a sitting), and only those ending at/after :endedSince — a
-- book abandoned months ago does not describe what anyone is up to. Both filters run before the
-- aggregate, so MAX() yields that user's newest qualifying listen. `book_id` is a bare column beside
-- `MAX(ended_at)`: SQLite guarantees bare columns in a single-min/max aggregate come from the row that
-- produced the extreme. Callers still ACL-filter every returned book_id — this query is viewer-agnostic.
selectLatestUnfinishedListenPerUserExcluding:
SELECT e.user_id, e.book_id, MAX(e.ended_at) AS ended_at
FROM listening_events e
WHERE e.user_id != :excludeUserId
  AND e.deleted_at IS NULL
  AND e.ended_at >= :endedSince
  AND e.ended_at - e.started_at >= :minDurationMs
  AND NOT EXISTS (
      SELECT 1 FROM playback_positions p
      WHERE p.user_id = e.user_id AND p.book_id = e.book_id AND p.finished = 1 AND p.deleted_at IS NULL
  )
GROUP BY e.user_id
ORDER BY ended_at DESC;

-- True iff the user has at least one live (non-deleted) listening event — drives
-- ListeningEventDomainSeeder.isAlreadySeeded.
hasAnyLiveForUser:
SELECT EXISTS(SELECT 1 FROM listening_events WHERE user_id = :userId AND deleted_at IS NULL);
