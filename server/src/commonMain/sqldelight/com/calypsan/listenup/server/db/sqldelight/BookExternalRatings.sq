-- book_external_ratings: syncable, soft-deletable, revision-tracked. One outside catalog's rating
-- of one book. Column set matches V74__book_external_ratings.sql exactly.
-- FK declarations (REFERENCES books) and the `enabled` DEFAULT are omitted here: SQLDelight cannot
-- resolve cross-table references for tables not yet defined in this schema's .sq files, and the
-- generated insert binding supplies every column explicitly regardless of a DEFAULT. Both
-- constraints are present in the migration DDL and enforced by SQLite at runtime.
--
-- Per-source health (last successful fetch, last error) does NOT live on this table — see
-- RatingSourceSettings for why: a row only exists once a source has succeeded at least once, so
-- health derived from these rows would be blind to a source that has never worked at all.
CREATE TABLE book_external_ratings (
    id           TEXT    NOT NULL,
    book_id      TEXT    NOT NULL,
    source       TEXT    NOT NULL,
    average      REAL    NOT NULL,
    count        INTEGER NOT NULL,
    enabled      INTEGER NOT NULL,
    region       TEXT,
    fetched_at   INTEGER NOT NULL,
    created_at   INTEGER NOT NULL,
    updated_at   INTEGER NOT NULL,
    revision     INTEGER NOT NULL,
    deleted_at   INTEGER,
    client_op_id TEXT,
    PRIMARY KEY (book_id, source)
);

CREATE UNIQUE INDEX idx_book_external_ratings_id ON book_external_ratings(id);
CREATE INDEX idx_book_external_ratings_source ON book_external_ratings(source) WHERE deleted_at IS NULL;
CREATE INDEX idx_book_external_ratings_fetched ON book_external_ratings(fetched_at);
CREATE INDEX idx_book_external_ratings_revision ON book_external_ratings(revision);

existsById:
SELECT EXISTS(SELECT 1 FROM book_external_ratings WHERE id = :id);

-- `AND deleted_at IS NULL` (matching book_ratings, unlike book_moods) so a repeat tombstone of an
-- already-deleted row matches zero rows: the base's softDelete then reports NotFound instead of
-- re-stamping the tombstone, bumping a revision, and re-publishing a Deleted event for nothing.
softDeleteById:
UPDATE book_external_ratings
SET revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at, client_op_id = :client_op_id
WHERE id = :id AND deleted_at IS NULL;

selectIdsAboveRevision:
SELECT id, revision FROM book_external_ratings WHERE revision > :cursor ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMost:
SELECT id, revision FROM book_external_ratings WHERE deleted_at IS NULL AND revision <= :cursor;

selectIdByNaturalPair:
SELECT id FROM book_external_ratings WHERE book_id = :book_id AND source = :source;

selectById:
SELECT * FROM book_external_ratings WHERE id = :id;

selectByIds:
SELECT * FROM book_external_ratings WHERE id IN :ids;

selectLiveForBook:
SELECT * FROM book_external_ratings WHERE book_id = :book_id AND deleted_at IS NULL;

selectLiveIdsForSource:
SELECT id FROM book_external_ratings WHERE source = :source AND deleted_at IS NULL;

setEnabledById:
UPDATE book_external_ratings
SET enabled = :enabled, revision = :revision, updated_at = :updated_at
WHERE id = :id;

insert:
INSERT INTO book_external_ratings (
    id, book_id, source, average, count, enabled, region, fetched_at,
    created_at, updated_at, revision, deleted_at, client_op_id
) VALUES (
    :id, :book_id, :source, :average, :count, :enabled, :region, :fetched_at,
    :created_at, :updated_at, :revision, NULL, :client_op_id
);

update:
UPDATE book_external_ratings
SET average = :average, count = :count, enabled = :enabled, region = :region, fetched_at = :fetched_at,
    updated_at = :updated_at, revision = :revision, deleted_at = NULL,
    client_op_id = :client_op_id
WHERE book_id = :book_id AND source = :source;

-- The book ids a sweep should refresh next: every live book, ordered by how long it has been since
-- the book was last genuinely touched — the earliest of any of its sources' fetches (so a book with
-- one stale source among several keeps rotating in), or its most recent fetch *attempt* by any source
-- (external_rating_attempts — see that table's own comment), whichever is MORE recent. A book with
-- neither sorts as if touched at instant 0 — first in line. Without the attempts half, a book that
-- never earns a row (no source rates it, or every fetch errors) would sort first FOREVER, consuming
-- the whole nightly quota and starving every other book. No ASIN is required: each source decides
-- for itself whether it can rate a book (Hardcover also matches by ISBN or title).
selectSweepCandidates:
SELECT b.id FROM books b
LEFT JOIN (
    SELECT book_id, MIN(fetched_at) AS fetched_at
    FROM book_external_ratings
    WHERE deleted_at IS NULL
    GROUP BY book_id
) r ON r.book_id = b.id
LEFT JOIN (
    SELECT book_id, MAX(attempted_at) AS attempted_at
    FROM external_rating_attempts
    GROUP BY book_id
) a ON a.book_id = b.id
WHERE b.deleted_at IS NULL
ORDER BY MAX(COALESCE(r.fetched_at, 0), COALESCE(a.attempted_at, 0)) ASC, b.id ASC
LIMIT :limit;

-- The sweep's 1/30th-a-night arithmetic denominator: every live book is eligible.
countLiveBooks:
SELECT COUNT(*) FROM books WHERE deleted_at IS NULL;

-- The most recently fetched source's region for this book, reused so a refetch (nightly sweep or
-- admin refresh) runs in the same region a rating was last found in. Null when the book has never
-- had a live row (falls back to the server's default metadata region at the call site).
selectRegionForBook:
SELECT region FROM book_external_ratings WHERE book_id = :book_id AND deleted_at IS NULL ORDER BY fetched_at DESC LIMIT 1;

-- Live books, after :after in id order, that at least one of :sources has never attempted — fewer
-- than :source_count of them have an external_rating_attempts row (the caller passes the size of
-- :sources). ExternalRatingsBackfill's queue: it walks the library in id order a page at a time
-- (keyset on :after), so a huge library is never built as one in-memory list and a pass always
-- ends. The caller passes only the sources that can run right now, so a source with no connection
-- never makes every book a candidate; once it can run, its missing books are exactly what this
-- returns.
selectBooksMissingAttempt:
SELECT b.id FROM books b
WHERE b.deleted_at IS NULL
  AND b.id > :after
  AND (
    SELECT COUNT(*) FROM external_rating_attempts a
    WHERE a.book_id = b.id AND a.source IN :sources
  ) < :source_count
ORDER BY b.id ASC
LIMIT :limit;
