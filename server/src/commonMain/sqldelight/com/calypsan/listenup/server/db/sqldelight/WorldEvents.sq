-- world_events: Story World events, homed like entities and optionally anchored. See V97__story_world_events.sql.
CREATE TABLE world_events (
    id                 TEXT    NOT NULL PRIMARY KEY,
    home_series_id     TEXT,
    home_book_id       TEXT,
    book_id            TEXT,
    position_ms        INTEGER,
    type               TEXT    NOT NULL,
    text               TEXT    NOT NULL,
    detail             TEXT,
    subject_entity_id  TEXT,
    object_entity_id   TEXT,
    created_by         TEXT,
    updated_by         TEXT,
    created_at         INTEGER NOT NULL,
    updated_at         INTEGER NOT NULL,
    revision           INTEGER NOT NULL,
    deleted_at         INTEGER,
    client_op_id       TEXT,
    CHECK ((home_series_id IS NULL) != (home_book_id IS NULL)),
    CHECK ((book_id IS NULL) = (position_ms IS NULL)),
    CHECK (position_ms IS NULL OR position_ms >= 0)
);

CREATE INDEX idx_world_events_home_series ON world_events(home_series_id) WHERE deleted_at IS NULL;
CREATE INDEX idx_world_events_home_book ON world_events(home_book_id);
CREATE INDEX idx_world_events_anchor ON world_events(book_id, position_ms);
CREATE INDEX idx_world_events_revision ON world_events(revision);

-- ── Substrate (SyncableSubstrateQueries) ──

existsById:
SELECT EXISTS(SELECT 1 FROM world_events WHERE id = :id);

softDeleteById:
UPDATE world_events
SET revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at, client_op_id = :client_op_id
WHERE id = :id;

selectIdsAboveRevision:
SELECT id, revision FROM world_events WHERE revision > :cursor ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMost:
SELECT id, revision FROM world_events WHERE deleted_at IS NULL AND revision <= :cursor;

-- ── Reads (tombstone-inclusive unless named Live) ──

selectById:
SELECT * FROM world_events WHERE id = :id;

selectByIds:
SELECT * FROM world_events WHERE id IN :ids;

selectLiveBySeries:
SELECT * FROM world_events WHERE home_series_id = :home_series_id AND deleted_at IS NULL ORDER BY created_at, id;

selectLiveByBook:
SELECT * FROM world_events WHERE home_book_id = :home_book_id AND deleted_at IS NULL ORDER BY created_at, id;

selectLiveMentioning:
SELECT * FROM world_events
WHERE deleted_at IS NULL AND id IN (SELECT event_id FROM world_event_mentions WHERE entity_id = :entity_id)
ORDER BY created_at, id;

-- ── Integrity (WorldEventIntegrity) ──

isLiveBook:
SELECT EXISTS(SELECT 1 FROM books WHERE id = :id AND deleted_at IS NULL);

isLiveBookInSeries:
SELECT EXISTS(
    SELECT 1 FROM book_series_memberships m JOIN books b ON b.id = m.book_id AND b.deleted_at IS NULL
    WHERE m.book_id = :book_id AND m.series_id = :series_id
);

-- Mention candidates that are entities of a series-homed world (deleted ones included).
selectEntityIdsInSeries:
SELECT id FROM entities WHERE id IN :ids AND home_series_id = :home_series_id;

-- Mention candidates that are entities of a book-homed world (deleted ones included).
selectEntityIdsInBook:
SELECT id FROM entities WHERE id IN :ids AND home_book_id = :home_book_id;

-- ── Book removal cascade ──

-- Does this book home or anchor any live event? The cascade skips its transaction (and revision) when not.
hasLiveTouchingBook:
SELECT EXISTS(
    SELECT 1 FROM world_events
    WHERE (home_book_id = :home_book_id OR book_id = :anchor_book_id) AND deleted_at IS NULL
);

selectLiveIdsTouchingBook:
SELECT id FROM world_events
WHERE (home_book_id = :home_book_id OR book_id = :anchor_book_id) AND deleted_at IS NULL
ORDER BY id;

-- Book re-add: the events a book removal tombstoned — those whose newest history row is a DELETE with no
-- actor (the cascade's). Keyed on history for the reason Entities.sq's twin documents.
selectCascadeDeletedForBooks:
SELECT w.id FROM world_events w
WHERE (w.home_book_id IN :home_book_ids OR w.book_id IN :anchor_book_ids) AND w.deleted_at IS NOT NULL
  AND EXISTS (
    SELECT 1 FROM story_world_history h
    WHERE h.target_type = 'world_event' AND h.target_id = w.id AND h.op = 'DELETE' AND h.actor_id IS NULL
      AND h.revision = (
        SELECT MAX(h2.revision) FROM story_world_history h2
        WHERE h2.target_type = 'world_event' AND h2.target_id = w.id
      )
  )
ORDER BY w.id;

-- The scoped AccessChanged delta asks by book id: every event homed on, or anchored to, one of these books,
-- plus every event homed on a series that contains one. Tombstones included (the delta must deliver them).
selectIdsTouchingBooks:
SELECT w.id FROM world_events w WHERE w.home_book_id IN :home_book_ids OR w.book_id IN :anchor_book_ids
UNION
SELECT w.id FROM world_events w
JOIN book_series_memberships m ON m.series_id = w.home_series_id
WHERE m.book_id IN :member_book_ids;

-- ── Writes ──

insert:
INSERT INTO world_events (id, home_series_id, home_book_id, book_id, position_ms, type, text, detail,
    subject_entity_id, object_entity_id, created_by, updated_by, created_at, updated_at, revision,
    deleted_at, client_op_id)
VALUES (:id, :home_series_id, :home_book_id, :book_id, :position_ms, :type, :text, :detail,
    :subject_entity_id, :object_entity_id, :created_by, :updated_by, :created_at, :updated_at, :revision,
    NULL, :client_op_id);

update:
UPDATE world_events
SET home_series_id = :home_series_id, home_book_id = :home_book_id, book_id = :book_id, position_ms = :position_ms,
    type = :type, text = :text, detail = :detail, subject_entity_id = :subject_entity_id,
    object_entity_id = :object_entity_id, updated_by = :updated_by, updated_at = :updated_at,
    revision = :revision, deleted_at = NULL, client_op_id = :client_op_id
WHERE id = :id;
