-- hardcover_book_exclusions: the books each listener keeps off Hardcover (#1541). See
-- V83__hardcover_book_exclusions.sql for each column. FKs (→ users, → books ON DELETE CASCADE) live in the
-- migration DDL.
CREATE TABLE hardcover_book_exclusions (
    user_id     TEXT    NOT NULL,
    book_id     TEXT    NOT NULL,
    excluded_at INTEGER NOT NULL,
    PRIMARY KEY (user_id, book_id)
);

CREATE INDEX idx_hardcover_book_exclusions_book ON hardcover_book_exclusions(book_id);

-- Keeping it off twice keeps the first time: syncing again catches up from then.
insertExclusion:
INSERT OR IGNORE INTO hardcover_book_exclusions (user_id, book_id, excluded_at)
VALUES (:user_id, :book_id, :excluded_at);

selectExclusion:
SELECT excluded_at FROM hardcover_book_exclusions WHERE user_id = :user_id AND book_id = :book_id;

deleteExclusion:
DELETE FROM hardcover_book_exclusions WHERE user_id = :user_id AND book_id = :book_id;

isExcluded:
SELECT EXISTS(SELECT 1 FROM hardcover_book_exclusions WHERE user_id = :user_id AND book_id = :book_id);

-- The listener's kept-off books still in the library, by title: the list the Hardcover screen opens.
keptOffBooks:
SELECT x.book_id
FROM hardcover_book_exclusions AS x
JOIN books AS b ON b.id = x.book_id AND b.deleted_at IS NULL
WHERE x.user_id = :user_id
ORDER BY b.title COLLATE NOCASE, x.book_id;

-- How many of them there are: Connected's keptOffBookCount.
countKeptOffBooks:
SELECT COUNT(*)
FROM hardcover_book_exclusions AS x
JOIN books AS b ON b.id = x.book_id AND b.deleted_at IS NULL
WHERE x.user_id = :user_id;
