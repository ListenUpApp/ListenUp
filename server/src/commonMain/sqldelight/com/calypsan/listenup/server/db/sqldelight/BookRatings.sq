-- book_ratings: syncable, soft-deletable, revision-tracked. One listener's rating of one book.
-- Column set matches V72__book_ratings.sql exactly.
-- FK declarations (REFERENCES books/users) are omitted here: SQLDelight cannot resolve
-- cross-table references for tables not yet defined in this schema's .sq files. The
-- constraints (including the half_stars CHECK) are present in the migration DDL and
-- enforced by SQLite at runtime.
CREATE TABLE book_ratings (
    id           TEXT    NOT NULL,
    book_id      TEXT    NOT NULL,
    user_id      TEXT    NOT NULL,
    half_stars   INTEGER NOT NULL,
    note         TEXT,
    rated_at     INTEGER NOT NULL,
    created_at   INTEGER NOT NULL,
    updated_at   INTEGER NOT NULL,
    revision     INTEGER NOT NULL,
    deleted_at   INTEGER,
    client_op_id TEXT,
    PRIMARY KEY (book_id, user_id)
);

CREATE UNIQUE INDEX idx_book_ratings_id ON book_ratings(id);
CREATE INDEX idx_book_ratings_user ON book_ratings(user_id) WHERE deleted_at IS NULL;
CREATE INDEX idx_book_ratings_revision ON book_ratings(revision);

existsById:
SELECT EXISTS(SELECT 1 FROM book_ratings WHERE id = :id);

-- `AND deleted_at IS NULL` (unlike book_moods' softDeleteById) so a repeat clear of an
-- already-tombstoned row matches zero rows: the base's softDelete then reports NotFound instead of
-- re-stamping the tombstone, bumping a revision, and re-publishing a Deleted event for nothing.
softDeleteById:
UPDATE book_ratings
SET revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at, client_op_id = :client_op_id
WHERE id = :id AND deleted_at IS NULL;

selectIdsAboveRevision:
SELECT id, revision FROM book_ratings WHERE revision > :cursor ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMost:
SELECT id, revision FROM book_ratings WHERE deleted_at IS NULL AND revision <= :cursor;

selectIdByNaturalPair:
SELECT id FROM book_ratings WHERE book_id = :book_id AND user_id = :user_id;

selectById:
SELECT * FROM book_ratings WHERE id = :id;

selectByIds:
SELECT * FROM book_ratings WHERE id IN :ids;

selectLiveForBook:
SELECT * FROM book_ratings WHERE book_id = :book_id AND deleted_at IS NULL;

selectLiveIdsForUser:
SELECT id FROM book_ratings WHERE user_id = :user_id AND deleted_at IS NULL;

selectLiveIdsForBook:
SELECT id FROM book_ratings WHERE book_id = :book_id AND deleted_at IS NULL;

-- Tombstoned ratings for a batch of books at or after :floor — the revive counterpart to
-- selectLiveIdsForBook, floored on the book-removal cascade instant (mirrors BookMoods): only
-- ratings tombstoned BY the book removal return with the book on re-add.
selectDeletedForBooksSince:
SELECT * FROM book_ratings WHERE book_id IN :book_ids AND deleted_at IS NOT NULL AND deleted_at >= :floor;

-- Revives a tombstoned rating (clears deleted_at, bumps revision) so clients reflow it as live.
reviveById:
UPDATE book_ratings SET revision = :revision, updated_at = :updated_at, deleted_at = NULL WHERE id = :id;

insert:
INSERT INTO book_ratings (id, book_id, user_id, half_stars, note, rated_at, created_at, updated_at, revision, deleted_at, client_op_id)
VALUES (:id, :book_id, :user_id, :half_stars, :note, :rated_at, :created_at, :updated_at, :revision, NULL, :client_op_id);

-- Re-rating (or reviving a cleared rating) keeps the row's id and first rated_at.
update:
UPDATE book_ratings
SET half_stars = :half_stars, note = :note, updated_at = :updated_at, revision = :revision,
    deleted_at = NULL, client_op_id = :client_op_id
WHERE book_id = :book_id AND user_id = :user_id;
