-- hardcover_pushed_reads: every Hardcover read ListenUp opened or continued (origin LIVE) or wrote as
-- history (origin HISTORY, #1540), kept so the pull (B3) can skip its own pushes. No FK to books on purpose (see V76); FK → users lives in the migration.
CREATE TABLE hardcover_pushed_reads (
    user_id     TEXT    NOT NULL,
    hc_read_id  INTEGER NOT NULL,
    book_id     TEXT    NOT NULL,
    recorded_at INTEGER NOT NULL,
    origin      TEXT    NOT NULL DEFAULT 'LIVE',
    PRIMARY KEY (user_id, hc_read_id)
);

-- origin: LIVE for a read a listen-through opened or continued; HISTORY for one a HISTORY row wrote (#1540).
recordPushedRead:
INSERT OR IGNORE INTO hardcover_pushed_reads (user_id, hc_read_id, book_id, recorded_at, origin)
VALUES (:user_id, :hc_read_id, :book_id, :recorded_at, :origin);

-- Whether ListenUp pushed read :hc_read_id live: such a read never counts as an earlier read for history.
isLivePushedRead:
SELECT EXISTS(SELECT 1 FROM hardcover_pushed_reads WHERE user_id = :user_id AND hc_read_id = :hc_read_id AND origin = 'LIVE');

isPushedRead:
SELECT EXISTS(SELECT 1 FROM hardcover_pushed_reads WHERE user_id = :user_id AND hc_read_id = :hc_read_id);

-- The pull's echo check, a page at a time: which of :hc_read_ids ListenUp opened or continued.
pushedAmong:
SELECT hc_read_id FROM hardcover_pushed_reads WHERE user_id = :user_id AND hc_read_id IN :hc_read_ids;
