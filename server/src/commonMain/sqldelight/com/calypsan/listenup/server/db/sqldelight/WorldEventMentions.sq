-- world_event_mentions: the entities of an event's world that the event names. Server-derived, replaced
-- wholesale (delete then insert) in the same transaction as the event's write. See V97__story_world_events.sql.
CREATE TABLE world_event_mentions (
    event_id   TEXT NOT NULL,
    entity_id  TEXT NOT NULL,
    PRIMARY KEY (event_id, entity_id)
);

CREATE INDEX idx_world_event_mentions_entity ON world_event_mentions(entity_id);

deleteForEvent:
DELETE FROM world_event_mentions WHERE event_id = :event_id;

insert:
INSERT INTO world_event_mentions (event_id, entity_id) VALUES (:event_id, :entity_id);

-- Hydrates mentionIds for a page of events in one query.
selectForEvents:
SELECT event_id, entity_id FROM world_event_mentions WHERE event_id IN :event_ids ORDER BY event_id, entity_id;
