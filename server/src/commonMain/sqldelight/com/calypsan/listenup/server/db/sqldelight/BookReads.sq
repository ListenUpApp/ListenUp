-- book_reads: per-completion read history — one row per time a user finished a book. Re-reads stack
-- as distinct rows. PLAIN (NON-syncable) server-only persistence, read by the readership RPC, never
-- streamed over sync. source says whose read it is:
--   'playback'  — ListenUp listening (recordCompletion); a replay may move its finished_at;
--   'reconcile' — a finish recovered from a finished position during a stats rebuild;
--   'hardcover' — a read logged on Hardcover and pulled (#601 B3). hc_read_id names it; it is deleted
--                 when that read vanishes from Hardcover, and it never counts as listening.
-- started_at is the day the reader said they started, when they picked one in "Mark as finished"; NULL
-- otherwise. It dates the read's start when the read is sent to Hardcover as history.
-- EVERY query below is classified in BookReadsQueriesClassifiedTest: a query that means "what the user
-- listened to" carries `source <> 'hardcover'` literally.
CREATE TABLE book_reads (
    id          TEXT    NOT NULL PRIMARY KEY,
    user_id     TEXT    NOT NULL,
    book_id     TEXT    NOT NULL,
    finished_at INTEGER NOT NULL,
    source      TEXT    NOT NULL,
    created_at  INTEGER NOT NULL,
    hc_read_id  INTEGER,
    started_at  INTEGER
);

CREATE INDEX idx_book_reads_book      ON book_reads(book_id);
CREATE INDEX idx_book_reads_user_book ON book_reads(user_id, book_id);
CREATE UNIQUE INDEX idx_book_reads_user_hc_read ON book_reads(user_id, hc_read_id);

-- Append a completion row unconditionally (a fresh id per finish, so re-reads stack).
insert:
INSERT INTO book_reads (id, user_id, book_id, finished_at, source, created_at)
VALUES (:id, :user_id, :book_id, :finished_at, :source, :created_at);

-- Append a completion row the reader dated the start of (a picked start in "Mark as finished").
insertWithStart:
INSERT INTO book_reads (id, user_id, book_id, finished_at, source, created_at, started_at)
VALUES (:id, :user_id, :book_id, :finished_at, :source, :created_at, :started_at);

-- Every finish of a book across all users, newest-first — Hardcover reads INCLUDED: the Readers section
-- shows them, badged. SocialServiceImpl.bookReadership splits them from ListenUp's by source.
finishesForBook:
SELECT * FROM book_reads
WHERE book_id = :bookId
ORDER BY finished_at DESC;

-- This user's ListenUp completions of one book, newest-first.
finishesForUserBook:
SELECT finished_at FROM book_reads
WHERE user_id = :userId AND book_id = :bookId AND source <> 'hardcover'
ORDER BY finished_at DESC;

-- Distinct books a user finished IN LISTENUP at/after a cutoff — the windowed "books finished"
-- leaderboard metric (re-reads of the same book collapse to one via COUNT DISTINCT).
countDistinctFinishedSince:
SELECT COUNT(DISTINCT book_id) FROM book_reads
WHERE user_id = :userId AND finished_at >= :cutoffMs AND source <> 'hardcover';

-- All-time ListenUp completions for a user (re-reads counted) — the all-time booksFinished metric.
countForUser:
SELECT COUNT(*) FROM book_reads WHERE user_id = :userId AND source <> 'hardcover';

-- The most recent ListenUp completion for a user+book pair (id + timestamp). The re-read rule reads its
-- finished_at as the "previous finish" and, on a below-threshold replay, updates that row in place —
-- so a pulled Hardcover read must never be it.
latestFinishForUserBook:
SELECT id, finished_at FROM book_reads
WHERE user_id = :userId AND book_id = :bookId AND source <> 'hardcover'
ORDER BY finished_at DESC
LIMIT 1;

-- Move an existing completion's finish time forward (the below-threshold "same read" case). Only ever
-- given an id from latestFinishForUserBook, which excludes Hardcover reads.
updateFinishedAtById:
UPDATE book_reads SET finished_at = :finished_at WHERE id = :id;

-- Re-date an existing completion's start to the day the reader picked (the same "same read" case). Only
-- ever given an id from latestFinishForUserBook.
updateStartedAtById:
UPDATE book_reads SET started_at = :started_at WHERE id = :id;

-- True iff the user has a ListenUp completion row for this book — gates the idempotent reconcile insert.
existsForUserBook:
SELECT EXISTS(SELECT 1 FROM book_reads WHERE user_id = :userId AND book_id = :bookId AND source <> 'hardcover');

-- Stats support: every ListenUp completion timestamp for a user. Feeds the streak day-set so an imported
-- finish that never produced a listening_events session still counts as a listening day. Re-reads add
-- multiple rows; the streak reducer collapses same-day duplicates.
finishedAtForUser:
SELECT finished_at FROM book_reads WHERE user_id = :userId AND source <> 'hardcover';

-- ── Pulled Hardcover reads (#601 B3). Written only by HardcoverPullStore / HardcoverConnectionStore. ──

-- A pulled read's row id derives from its Hardcover id (pulledReadRowId), so writing it again is a no-op.
insertPulled:
INSERT OR IGNORE INTO book_reads (id, user_id, book_id, finished_at, source, created_at, hc_read_id)
VALUES (:id, :user_id, :book_id, :finished_at, 'hardcover', :created_at, :hc_read_id);

-- A pulled read's finish date changed on Hardcover, or it now resolves to another book.
updatePulled:
UPDATE book_reads SET book_id = :book_id, finished_at = :finished_at
WHERE user_id = :user_id AND hc_read_id = :hc_read_id AND source = 'hardcover';

deletePulledForUserBook:
DELETE FROM book_reads WHERE user_id = :user_id AND book_id = :book_id AND source = 'hardcover';

-- Reads gone from a shelf entry (deleted, or no longer finished) go; the rest stay.
deletePulledForUserBookExcept:
DELETE FROM book_reads
WHERE user_id = :user_id AND book_id = :book_id AND source = 'hardcover' AND hc_read_id NOT IN :keep;

-- A full pull has completed: pulled reads of books whose shelf entry it never saw are gone from Hardcover.
deletePulledNotSeenSince:
DELETE FROM book_reads
WHERE user_id = :user_id AND source = 'hardcover'
  AND book_id NOT IN (
    SELECT l.book_id FROM hardcover_book_links AS l
    WHERE l.user_id = :user_id AND l.match_state = 'LINKED' AND l.pull_seen_at >= :since
  );

-- Disconnect, or a different Hardcover account: the mirror goes with the connection.
deletePulledForUser:
DELETE FROM book_reads WHERE user_id = :user_id AND source = 'hardcover';

-- Whether any of the user's Hardcover reads of one book are mirrored here: what keeping the book off
-- Hardcover would take out of Readers (#1541).
hasPulledForUserBook:
SELECT EXISTS(SELECT 1 FROM book_reads WHERE user_id = :user_id AND book_id = :book_id AND source = 'hardcover');

pulledForUser:
SELECT book_id, finished_at, hc_read_id FROM book_reads
WHERE user_id = :user_id AND source = 'hardcover'
ORDER BY book_id, hc_read_id;
