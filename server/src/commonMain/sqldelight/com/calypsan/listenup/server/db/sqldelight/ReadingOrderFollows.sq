-- reading_order_follows (#962): each user's choice of order per series. Syncable, soft-deletable,
-- revision-tracked, and userScoped — every row carries its owner's user_id, so the per-user substrate
-- variants filter every pull/digest by that user. `id` is "<user_id>:<series_id>".
-- Column set matches V96__reading_orders.sql exactly.
CREATE TABLE reading_order_follows (
    id               TEXT    NOT NULL PRIMARY KEY,
    user_id          TEXT    NOT NULL,
    series_id        TEXT    NOT NULL,
    choice           TEXT    NOT NULL,
    reading_order_id TEXT,
    created_at       INTEGER NOT NULL,
    updated_at       INTEGER NOT NULL,
    revision         INTEGER NOT NULL,
    deleted_at       INTEGER,
    client_op_id     TEXT
);

CREATE UNIQUE INDEX idx_reading_order_follows_user_series ON reading_order_follows(user_id, series_id);
CREATE INDEX idx_reading_order_follows_order ON reading_order_follows(reading_order_id) WHERE deleted_at IS NULL;
CREATE INDEX idx_reading_order_follows_revision ON reading_order_follows(revision);

-- Global substrate queries (kept for the base contract; the userScoped repo routes pull/digest
-- through the *ForUser variants).

existsById:
SELECT EXISTS(SELECT 1 FROM reading_order_follows WHERE id = :id);

softDeleteById:
UPDATE reading_order_follows
SET revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at,
    client_op_id = :client_op_id
WHERE id = :id;

selectIdsAboveRevision:
SELECT id, revision FROM reading_order_follows WHERE revision > :cursor ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMost:
SELECT id, revision FROM reading_order_follows WHERE deleted_at IS NULL AND revision <= :cursor;

-- User-scoped substrate variants: user A's pull never observes user B's choices.

selectIdsAboveRevisionForUser:
SELECT id, revision FROM reading_order_follows
WHERE user_id = :userId AND revision > :cursor
ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMostForUser:
SELECT id, revision FROM reading_order_follows
WHERE user_id = :userId AND deleted_at IS NULL AND revision <= :cursor;

-- Domain queries.

selectById:
SELECT * FROM reading_order_follows WHERE id = :id;

selectByIds:
SELECT * FROM reading_order_follows WHERE id IN :ids;

-- Every live follow of an order, across users — the delete cascade's fan-out set.
selectLiveFollowersOfOrder:
SELECT id, user_id FROM reading_order_follows
WHERE reading_order_id = :reading_order_id AND deleted_at IS NULL;

countLiveFollowersOfOrder:
SELECT COUNT(*) FROM reading_order_follows WHERE reading_order_id = :reading_order_id AND deleted_at IS NULL;

insert:
INSERT INTO reading_order_follows (id, user_id, series_id, choice, reading_order_id, created_at, updated_at, revision, deleted_at, client_op_id)
VALUES (:id, :user_id, :series_id, :choice, :reading_order_id, :created_at, :updated_at, :revision, :deleted_at, :client_op_id);

update:
UPDATE reading_order_follows
SET choice = :choice, reading_order_id = :reading_order_id, revision = :revision,
    updated_at = :updated_at, deleted_at = :deleted_at, client_op_id = :client_op_id
WHERE id = :id;
