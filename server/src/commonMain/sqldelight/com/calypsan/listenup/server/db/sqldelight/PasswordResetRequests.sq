-- password_reset_requests: server-owned, non-syncable. Schema matches V56 exactly.
--
-- SECURITY-RELEVANT properties:
--   * code_hash is NULL until an admin approves — an unapproved request has no code to guess.
--   * attempts is incremented on every credential mismatch; the service kills the request at 5.
--   * Expiry is enforced in the WHERE clause of the read paths, so a missed purge can never
--     resurrect a request.
CREATE TABLE password_reset_requests (
    id                TEXT    NOT NULL PRIMARY KEY,
    user_id           TEXT    NOT NULL,
    requested_at      INTEGER NOT NULL,
    expires_at        INTEGER NOT NULL,
    status            TEXT    NOT NULL,
    device_claim_hash TEXT    NOT NULL,
    code_hash         TEXT,
    attempts          INTEGER NOT NULL DEFAULT 0,
    decided_by        TEXT,
    decided_at        INTEGER
);

CREATE INDEX idx_password_reset_requests_status ON password_reset_requests(status, expires_at);
CREATE INDEX idx_password_reset_requests_user ON password_reset_requests(user_id);

insert:
INSERT INTO password_reset_requests (
    id, user_id, requested_at, expires_at, status, device_claim_hash, code_hash, attempts, decided_by, decided_at
) VALUES (:id, :user_id, :requested_at, :expires_at, :status, :device_claim_hash, NULL, 0, NULL, NULL);

-- By id, regardless of state. The service decides what the state means.
selectById:
SELECT * FROM password_reset_requests WHERE id = :id;

-- Live (unexpired, undecided-or-approved) request for an account. Drives supersession.
selectLiveForUser:
SELECT * FROM password_reset_requests
WHERE user_id = :user_id AND status IN ('PENDING', 'APPROVED') AND expires_at > :now;

-- The admin's queue, newest first.
selectPending:
SELECT * FROM password_reset_requests
WHERE status = 'PENDING' AND expires_at > :now
ORDER BY requested_at DESC;

markApproved:
UPDATE password_reset_requests
SET status = 'APPROVED', code_hash = :code_hash, decided_by = :decided_by, decided_at = :decided_at
WHERE id = :id;

markDenied:
UPDATE password_reset_requests
SET status = 'DENIED', decided_by = :decided_by, decided_at = :decided_at
WHERE id = :id;

markConsumed:
UPDATE password_reset_requests SET status = 'CONSUMED' WHERE id = :id;

markExpired:
UPDATE password_reset_requests SET status = 'EXPIRED' WHERE id = :id;

incrementAttempts:
UPDATE password_reset_requests SET attempts = attempts + 1 WHERE id = :id;

-- Supersede every live request for an account when a new one opens.
expireLiveForUser:
UPDATE password_reset_requests
SET status = 'EXPIRED'
WHERE user_id = :user_id AND status IN ('PENDING', 'APPROVED');

-- Sweep on user deletion.
deleteForUser:
DELETE FROM password_reset_requests WHERE user_id = :user_id;

-- Hygiene purge of long-dead rows. Not a correctness path — expiry is enforced on read.
deleteExpiredBefore:
DELETE FROM password_reset_requests WHERE expires_at < :before;
