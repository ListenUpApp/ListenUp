-- reading_orders (#962): a named, ordered list of books belonging to one series. Global (library-wide),
-- syncable, soft-deletable, revision-tracked. Column set matches V96__reading_orders.sql exactly.
CREATE TABLE reading_orders (
    id              TEXT    NOT NULL PRIMARY KEY,
    series_id       TEXT    NOT NULL,
    name            TEXT    NOT NULL,
    normalized_name TEXT    NOT NULL,
    created_by      TEXT    NOT NULL,
    created_at      INTEGER NOT NULL,
    updated_at      INTEGER NOT NULL,
    revision        INTEGER NOT NULL,
    deleted_at      INTEGER,
    client_op_id    TEXT
);

CREATE UNIQUE INDEX idx_reading_orders_series_name
    ON reading_orders(series_id, normalized_name) WHERE deleted_at IS NULL;
CREATE INDEX idx_reading_orders_series ON reading_orders(series_id) WHERE deleted_at IS NULL;
CREATE INDEX idx_reading_orders_revision ON reading_orders(revision);

-- Global substrate queries.

existsById:
SELECT EXISTS(SELECT 1 FROM reading_orders WHERE id = :id);

softDeleteById:
UPDATE reading_orders
SET revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at,
    client_op_id = :client_op_id
WHERE id = :id;

selectIdsAboveRevision:
SELECT id, revision FROM reading_orders WHERE revision > :cursor ORDER BY revision ASC LIMIT :limit;

selectIdRevAtMost:
SELECT id, revision FROM reading_orders WHERE deleted_at IS NULL AND revision <= :cursor;

-- Domain queries.

-- Tombstone-inclusive read by id — pullSince/readPayloads must hydrate tombstones.
selectById:
SELECT * FROM reading_orders WHERE id = :id;

selectByIds:
SELECT * FROM reading_orders WHERE id IN :ids;

-- The live order on a series whose normalized name matches — the per-series uniqueness probe.
selectLiveIdByName:
SELECT id FROM reading_orders
WHERE series_id = :series_id AND normalized_name = :normalized_name AND deleted_at IS NULL;

insert:
INSERT INTO reading_orders (id, series_id, name, normalized_name, created_by, created_at, updated_at, revision, deleted_at, client_op_id)
VALUES (:id, :series_id, :name, :normalized_name, :created_by, :created_at, :updated_at, :revision, :deleted_at, :client_op_id);

-- created_by and created_at are never rewritten: the maker is fixed at creation.
update:
UPDATE reading_orders
SET series_id = :series_id, name = :name, normalized_name = :normalized_name,
    revision = :revision, updated_at = :updated_at, deleted_at = :deleted_at, client_op_id = :client_op_id
WHERE id = :id;
