-- hardcover_connections: one row per user connected to Hardcover. Tokens are stored ENCRYPTED
-- (HardcoverTokenCipher); nothing here is ever sent to a client. broken_reason is set when a
-- once-working connection needs a reconnect (HardcoverBrokenReason name); NULL means healthy.
-- FK (→ users ON DELETE CASCADE) lives in the migration DDL.
CREATE TABLE hardcover_connections (
    user_id            TEXT    NOT NULL PRIMARY KEY,
    hc_user_id         INTEGER NOT NULL,
    hc_username        TEXT    NOT NULL,
    access_token_enc   TEXT    NOT NULL,
    access_expires_at  INTEGER NOT NULL,
    refresh_token_enc  TEXT    NOT NULL,
    refresh_expires_at INTEGER NOT NULL,
    scopes             TEXT    NOT NULL,
    connected_at       INTEGER NOT NULL,
    broken_reason      TEXT,
    last_synced_at     INTEGER,
    push_error         TEXT,
    pull_cursor          TEXT,
    pull_cursor_id       INTEGER,
    full_pull_started_at INTEGER,
    last_full_pull_at    INTEGER,
    pull_error           TEXT
);

selectByUser:
SELECT * FROM hardcover_connections WHERE user_id = :user_id;

-- A fresh connection replaces any previous (broken) one for the user.
upsertConnection:
INSERT OR REPLACE INTO hardcover_connections (
    user_id, hc_user_id, hc_username, access_token_enc, access_expires_at,
    refresh_token_enc, refresh_expires_at, scopes, connected_at, broken_reason
) VALUES (
    :user_id, :hc_user_id, :hc_username, :access_token_enc, :access_expires_at,
    :refresh_token_enc, :refresh_expires_at, :scopes, :connected_at, NULL
);

-- A rotated token pair from a refresh — committed BEFORE the new access token is used.
updateTokens:
UPDATE hardcover_connections
SET access_token_enc = :access_token_enc, access_expires_at = :access_expires_at,
    refresh_token_enc = :refresh_token_enc, refresh_expires_at = :refresh_expires_at, scopes = :scopes
WHERE user_id = :user_id;

markBroken:
UPDATE hardcover_connections SET broken_reason = :broken_reason WHERE user_id = :user_id;

deleteByUser:
DELETE FROM hardcover_connections WHERE user_id = :user_id;

-- Users whose connection is not marked broken, ROOT then ADMIN then MEMBER (oldest connection first
-- within a role): the accounts the server may borrow to look up a book's Hardcover rating.
-- Soft-deleted users are skipped.
selectHealthyUserIds:
SELECT c.user_id
FROM hardcover_connections AS c
JOIN users AS u ON u.id = c.user_id
WHERE c.broken_reason IS NULL AND u.deleted_at IS NULL
ORDER BY CASE u.role WHEN 'ROOT' THEN 0 WHEN 'ADMIN' THEN 1 ELSE 2 END, c.connected_at, c.user_id;

existsForUser:
SELECT EXISTS(SELECT 1 FROM hardcover_connections WHERE user_id = :user_id);

selectHcUserId:
SELECT hc_user_id FROM hardcover_connections WHERE user_id = :user_id;

-- A push landed: remember when, and clear any error that had outlasted the retry cap.
markSynced:
UPDATE hardcover_connections SET last_synced_at = :last_synced_at, push_error = NULL WHERE user_id = :user_id;

recordPushError:
UPDATE hardcover_connections SET push_error = :push_error WHERE user_id = :user_id;

selectPushHealth:
SELECT last_synced_at, push_error FROM hardcover_connections WHERE user_id = :user_id;

-- ── The pull (#601 B3) ───────────────────────────────────────────────────────
-- pull_cursor is Hardcover's own updated_at text, stored and sent back verbatim: never compared here.

selectPullState:
SELECT pull_cursor, pull_cursor_id, full_pull_started_at, last_full_pull_at
FROM hardcover_connections WHERE user_id = :user_id;

updatePullCursor:
UPDATE hardcover_connections SET pull_cursor = :pull_cursor, pull_cursor_id = :pull_cursor_id WHERE user_id = :user_id;

-- A full pull starts from the beginning of the shelf.
startFullPull:
UPDATE hardcover_connections
SET pull_cursor = NULL, pull_cursor_id = NULL, full_pull_started_at = :full_pull_started_at
WHERE user_id = :user_id;

finishFullPull:
UPDATE hardcover_connections SET full_pull_started_at = NULL, last_full_pull_at = :last_full_pull_at
WHERE user_id = :user_id;

-- The next pull is a full one ("Sync now", a changed match). A full pull already running restarts.
requestFullPull:
UPDATE hardcover_connections SET full_pull_started_at = NULL, last_full_pull_at = NULL WHERE user_id = :user_id;

-- A pull caught up: remember when, and clear any error that had outlasted its retry cap.
markPulled:
UPDATE hardcover_connections SET last_synced_at = :last_synced_at, pull_error = NULL WHERE user_id = :user_id;

recordPullError:
UPDATE hardcover_connections SET pull_error = :pull_error WHERE user_id = :user_id;
